---
import '../styles/global.css';
import Wallpaper from '../components/Wallpaper.astro';
import Taskbar from '../components/Taskbar.astro';
import DesktopIcons from '../components/DesktopIcons.astro';
import Welcome from '../components/Welcome.astro';

interface Props {
  title: string;
  description: string;
  /** show the mock welcome screen on the first visit of a session */
  welcome?: boolean;
}
const { title, description, welcome = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#245edb" />
    <link rel="icon" type="image/gif" sizes="64x64" href={`${base}favicon/face.gif`} data-favicon />
    <script is:inline define:vars={{ frames: [1, 2, 3].map((n) => `${base}favicon/face-${n}.png`) }}>
      // Animated favicon. Firefox plays the GIF itself; Chrome and Edge only
      // show a GIF's first frame, so swap the PNG frames by hand.
      (() => {
        const link = document.querySelector('link[data-favicon]');
        if (!link) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          link.type = 'image/png';
          link.href = frames[1];
          return;
        }
        frames.forEach((src) => (new Image().src = src)); // preload
        let i = 0;
        setInterval(() => {
          i = (i + 1) % frames.length;
          link.type = 'image/png';
          link.href = frames[i];
        }, 700);
      })();
    </script>
    {welcome && (
      <script is:inline>
        // Decide before first paint, so the desktop never flashes behind it.
        try {
          if (!sessionStorage.getItem('welcomed')) document.documentElement.dataset.welcome = '';
        } catch {
          document.documentElement.dataset.welcome = '';
        }
      </script>
    )}
  </head>
  <body>
    {welcome && <Welcome />}
    <a class="skip-link" href="#main">Skip to content</a>
    <Wallpaper />
    <DesktopIcons />
    <main id="main">
      <slot />
    </main>
    <Taskbar />
  </body>
</html>
