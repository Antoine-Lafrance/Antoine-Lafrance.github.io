---
// Shortcut icons down the left edge of the desktop (wide screens only).
import Icon, { type IconName } from './Icon.astro';
import { profile } from '../data/content';

const base = import.meta.env.BASE_URL;
const shortcuts: { label: string; href: string; icon: IconName }[] = [
  { label: 'About Me', href: `${base}#intro`, icon: 'user' },
  { label: 'Research', href: `${base}#research`, icon: 'folder' },
  { label: 'Blog', href: `${base}blog/`, icon: 'notepad' },
  { label: 'My CV', href: profile.cv, icon: 'document' },
  { label: 'E-mail', href: `mailto:${profile.email}`, icon: 'mail' },
];
---

<nav class="desktop-icons" aria-label="Shortcuts">
  {shortcuts.map((s) => (
    <a href={s.href}>
      <Icon name={s.icon} size={40} />
      <span>{s.label}</span>
    </a>
  ))}
</nav>

<style>
  .desktop-icons {
    position: fixed;
    top: 20px;
    left: 14px;
    z-index: 1;
    display: none;
    flex-direction: column;
    gap: 18px;
  }
  @media (min-width: 1240px) {
    .desktop-icons {
      display: flex;
    }
  }
  .desktop-icons a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 84px;
    padding: 4px;
    color: #fff;
    font-size: 12px;
    text-align: center;
    text-decoration: none;
    text-shadow: 1px 1px 1px #000;
  }
  .desktop-icons a:hover span,
  .desktop-icons a:focus-visible span {
    background: var(--select);
  }
  .desktop-icons a:focus-visible {
    outline: 1px dotted #fff;
  }
  .desktop-icons span {
    padding: 0 3px;
  }
</style>
